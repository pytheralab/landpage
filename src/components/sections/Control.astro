---
const { s } = Astro.props;
---
<section class:list={['section', { alt: s.background === 'alt' }]} id={s.anchor}>
  <div class="section-head">
    <span class="label">{s.label}</span>
    <h2>{s.title}</h2>
  </div>
  <div class="ctrl">
    {s.cards.map((c) => <div class="card"><span class="label">{c.label}</span><h3>{c.title}</h3><p>{c.text}</p></div>)}
  </div>
</section>
