---
const { s } = Astro.props;
---
<section class:list={['section', { alt: s.background === 'alt' }]} id={s.anchor}>
  <div class="section-head">
    {s.label && <span class="label">{s.label}</span>}
    <h2>{s.title}</h2>
  </div>
  <div class="faq">
    {s.items.map((it) => <details><summary>{it.q}</summary><p>{it.a}</p></details>)}
  </div>
</section>
